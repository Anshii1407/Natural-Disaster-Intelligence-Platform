# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI (Cloud DBaaS)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Client Application URL
CLIENT_URL=http://localhost:5173

# AI Service Microservice URL
AI_SERVICE_URL=http://localhost:8000

# Authentication (Phase 3)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Internal Microservice Secret (for AI service -> backend ingest)
INTERNAL_SERVICE_KEY=your_internal_service_secret_key_here

# Admin Provisioning Seed Defaults (used by `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@ndip.gov
SEED_ADMIN_PASSWORD=change_this_secure_admin_password
SEED_ADMIN_NAME="National Disaster Authority Admin"

# Cloudinary Storage Credentials (To be configured in Phase 4)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
